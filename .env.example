TX_NETWORK_ID=100
WALLET_PRIVATE_KEY=
STIPEND=93000000000000000000000
MAX_REWARD=500000000000000000000
REWARD_FORMULA_ADDRESS_TAGS="(reward_pool/(2*total_submissions)) + ((reward_pool*txns_with_contract)/(2*total_txns_with_all_contracts))"
REWARD_FORMULA_TOKENS="((token_tx/total_txns_with_all_contracts)*0.1*reward_pool) + ((sqrt(token_tx)/sum_sqrt_total_txns_with_all_contracts)*0.9*reward_pool)"
REWARD_FORMULA_DOMAINS="(reward_pool/(2*total_submissions)) + ((reward_pool*txns_with_contract)/(2*total_txns_with_all_contracts))"
REWARD_REDISTRIBUTE_CAPPED_ADDRESS_TAGS=true
REWARD_REDISTRIBUTE_CAPPED_TOKENS=false
REWARD_REDISTRIBUTE_CAPPED_DOMAINS=true
SOLANA_TX_DIVIDER=1000
SOLANA_TX_LOOKBACK_DAYS=0
# Removal reward pools and per-removal caps (in wei, per registry).
# Removers are rewarded a flat min(pool / removals_in_period, cap) per registry.
# Confirmed against the official payout record: each registry has a 7000 PNK
# monthly pool capped at 500 PNK/removal (e.g. June 2026: Domains had 38
# removals and saturated its pool at 184.21 each; saturated months total 21000).
REMOVAL_REWARD_POOL_ADDRESS_TAGS=7000000000000000000000
REMOVAL_REWARD_POOL_TOKENS=7000000000000000000000
REMOVAL_REWARD_POOL_DOMAINS=7000000000000000000000
REMOVAL_MAX_PER_REMOVAL_ADDRESS_TAGS=500000000000000000000
REMOVAL_MAX_PER_REMOVAL_TOKENS=500000000000000000000
REMOVAL_MAX_PER_REMOVAL_DOMAINS=500000000000000000000
# ATQ rewards (in wei). Registrations and removals are computed independently:
# each event of a kind gets min(pool / kind_event_count, cap).
# Official policy (Kleros Scout incentives posts, e.g. June & July 2026):
# submissions pool 60,000 PNK capped at 3,000 PNK per submission; removals
# pool 6,500 PNK capped at 500 PNK per removal.
REWARD_POOL_ATQ_SUBMISSIONS=60000000000000000000000
MAX_PER_ATQ_SUBMISSION=3000000000000000000000
REWARD_POOL_ATQ_REMOVALS=6500000000000000000000
MAX_PER_ATQ_REMOVAL=500000000000000000000
PNK=0xcb3231aBA3b451343e0Fddfc45883c842f223846
XDAI_GTCR_SUBGRAPH_URL=https://indexer.hyperindex.xyz/[api-key]/v1/graphql
XDAI_REGISTRY_ADDRESS_TAGS=0x66260c69d03837016d88c9877e61e08ef74c59f2
XDAI_REGISTRY_TOKENS=0xee1502e29795ef6c2d60f8d7120596abe3bad990
XDAI_REGISTRY_DOMAINS=0x957a53a994860be4750810131d9c876b2f52d6e1
XDAI_REGISTRY_ATQ=0xae6aaed5434244be3699c56e7ebc828194f26dc3
FILES_DIR=files
# Optional: IPFS documentation (`--mode document`). Without FILEBASE_TOKEN the
# structured JSON + index are still written locally, just not uploaded.
# FILEBASE_TOKEN=
# IPFS_GATEWAY=https://cdn.kleros.link/ipfs
# Optional: manual exclusion list applied by `generate` and `removals`
# (defaults to ./exclusions.json — see README "Exclusions").
# EXCLUSIONS_FILE=exclusions.json
DUNE_API_KEY=
DUNE_BASE_URL=https://api.dune.com/api/v1
DUNE_QUERY_PERFORMANCE=medium
DUNE_POLL_INTERVAL_SECONDS=2
DUNE_MAX_POLLS=600
DUNE_HTTP_MAX_RETRIES=6
DUNE_HTTP_RETRY_BASE_MS=2000
DUNE_STATUS_LOG_EVERY_POLLS=5
